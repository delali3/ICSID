# IEEE API Configuration
# Copy this file to .env and fill in your actual credentials

# Environment: TEST, QA, or PRODUCTION
IEEE_ENV=QA

# IEEE API Credentials (Get these from IEEE Developer Portal)
IEEE_CLIENT_ID=3529cbea-3d46-4f8e-8699-f7bd444cbc02
IEEE_CLIENT_SECRET=c6a707a5-b10e-478e-8bb4-af17c2cb720e
IEEE_SCOPE=GetMemberStatus

# OAuth Callback URL (Update with your domain)
IEEE_OAUTH_CALLBACK_URL=http://localhost/Conferences/ICSSII%20Conference/api/ieee-oauth-callback.php

# Database Configuration (if needed for storing registrations)
DB_HOST=localhost
DB_NAME=icssid_conference
DB_USER=root
DB_PASS=

# Application Settings
APP_DEBUG=true
APP_URL=http://localhost/Conferences/ICSSII%20Conference

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# Email Configuration (for sending confirmation emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=icssid2026@gmail.com
MAIL_FROM_NAME="ICSSID 2026 Conference"
